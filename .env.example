# Bot token from @BotFather
BOT_TOKEN=

# Required: owner for private access and commands (numeric user ID, not username)
OWNER_USER_ID=
# Optional: everyone may address the bot in these groups after the owner's /start
# (comma-separated negative IDs).
# Private access and commands stay owner-only. Empty keeps dialogue owner-only everywhere.
PUBLIC_GROUP_IDS=
# Optional additional sender IDs explicitly known to be authored by the owner.
# Includes channel IDs or legacy imported sender IDs. Narration only; grants no access.
OWNER_AUTHOR_IDS=

# OpenAI API key and model for AI conversations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Group name-addressing checks use OpenAI Decisions with the same key.
OPENAI_DECISION_MODEL=gpt-6-luna

# Optional Keenable API key: enables web search and reading public source pages
KEENABLE_API_KEY=

# Optional local timezone for dates sent to the AI
BOT_TIMEZONE=Europe/Moscow

# PostgreSQL + pgvector; generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Used by direct Python/CLI runs. Compose supplies its internal postgres URL.
DATABASE_URL=postgresql://dashulya:CHANGE_ME@postgres:5432/dashulya # pragma: allowlist secret -- Placeholder only.

# Optional memory evals; only the explicit eval run command uses these.
# A separate disposable PostgreSQL + pgvector database, never the application DB.
EVAL_DATABASE_URL=
# Semantic judge model; scores remain provisional until human calibration.
OPENAI_EVAL_JUDGE_MODEL=

# Optional log file path; logs rotate at 10 MiB with 5 backups
LOG_PATH=var/logs/dashulya.log
